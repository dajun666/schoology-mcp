# PAUSD Schoology / ClassLink credentials
# Student ID is the 8-digit number starting with 950.
SCHOOLOGY_USERNAME=950XXXXX

# Password: do NOT store it here in plaintext. Run this once instead:
#     python scripts/set_credentials.py
# It saves the password to a keyring (encrypted at rest). Only set
# SCHOOLOGY_PASSWORD below as a fallback if you cannot use a keyring --
# when set, it takes precedence over the keyring.
# SCHOOLOGY_PASSWORD=

# Keyring backend (default: os). The "os" backend uses the native keychain:
# macOS Keychain, Windows Credential Manager, or Linux Secret Service -- no
# extra config needed on a desktop.
# SCHOOLOGY_KEYRING_BACKEND=os
#
# On HEADLESS Linux (servers, WSL, Docker, cron) there is no OS secret store.
# Use the encrypted-file backend instead: set a master passphrase, which both
# selects the cryptfile backend and unlocks it. Run set_credentials.py with
# this set, and run the SERVER with the SAME value in its environment.
# SCHOOLOGY_KEYRING_PASS=change-me
# Optional: path to the encrypted file (default ~/.local/share/schoology-mcp/credentials.cfg)
# SCHOOLOGY_KEYRING_FILE=

# URLs (defaults shown; usually no need to change)
SCHOOLOGY_BASE_URL=https://pausd.schoology.com
CLASSLINK_URL=https://launchpad.classlink.com/pausd

# Set to false to watch the browser while it logs in (debugging).
SCHOOLOGY_HEADLESS=true

# Auto-refresh: keep the (short-lived) Schoology session warm in the background.
# Set SCHOOLOGY_KEEPALIVE=false to disable -- the server still re-logs in on
# demand whenever a tool call finds the session expired.
SCHOOLOGY_KEEPALIVE=true
SCHOOLOGY_KEEPALIVE_MINUTES=8
